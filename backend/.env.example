# Port the backend listens on (default 8080)
PORT=8080

# Instagram sessionid cookie — required for posts, reels & stories.
# Use a THROWAWAY account for this, never a personal one: automated traffic can
# get the account suspended. Log in to instagram.com with the throwaway account,
# then copy the cookie:
#   DevTools -> Application -> Cookies -> https://www.instagram.com -> sessionid
IG_SESSIONID=
