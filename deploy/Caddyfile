# {$DOMAIN} is injected from /opt/ig/.env via the compose environment.
# Caddy automatically obtains and renews Let's Encrypt certs for it.
{$DOMAIN} {
	encode zstd gzip

	# API + media downloads go straight to the Rust backend
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /download {
		reverse_proxy backend:8080
	}

	# Everything else -> Next.js
	handle {
		reverse_proxy frontend:3000
	}
}
