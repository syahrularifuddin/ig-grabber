# InstaBox/sandbox mode: the platform terminates TLS at its edge and forwards
# plain HTTP to the machine port (8080 via compose.instabox.yaml) — no cert
# management here. Publish machine port 8080 in the panel.
:80 {
	encode zstd gzip

	# API + media downloads go straight to the Rust backend
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /download {
		reverse_proxy backend:8080
	}

	# Everything else -> Next.js
	handle {
		reverse_proxy frontend:3000
	}
}
