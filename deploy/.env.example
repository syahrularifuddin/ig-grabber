# Copy to /opt/ig/.env on the VPS, then: chown 65534:65534 /opt/ig/.env
# (the backend container runs as uid 65534 and rewrites this file when the
# Instagram session cookie rolls or is renewed in-app).

# Public hostname Caddy serves + obtains a Let's Encrypt cert for.
# Point an A record at the VPS first. No domain yet? Use the VPS IP —
# Caddy will serve a self-signed cert (browser warning) instead.
DOMAIN=ig.example.com

# Instagram sessionid cookie — only needed for Stories.
# DevTools -> Application -> Cookies -> https://www.instagram.com -> sessionid
IG_SESSIONID=
